{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": ["Temporary change to trigger renovate-config-lint; revert before merge"],
	"extends": ["config:best-practices", ":pinAllExceptPeerDependencies"],
	"timezone": "Asia/Tokyo",
	"schedule": ["* 0-4 * * *"],
	"labels": ["dependencies"],
	"automerge": true,
	"packageRules": [
		{
			"groupName": "all non-major devDependencies",
			"groupSlug": "all-devDependencies-minor-patch",
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"]
		},
		{
			"groupName": "all non-major dependencies",
			"groupSlug": "all-dependencies-minor-patch",
			"matchDepTypes": ["dependencies"],
			"matchUpdateTypes": ["minor", "patch"]
		},
		{
			"groupName": "Major Updates",
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"minimumReleaseAge": "7 days"
		}
	]
}
