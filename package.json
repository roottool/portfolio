{
	"name": "portfolio",
	"version": "1.0.0",
	"private": true,
	"description": "My portfolio with Astro using TypeScript.",
	"homepage": "https://portfolio-6od.pages.dev",
	"bugs": {
		"url": "https://github.com/roottool/portfolio/issues"
	},
	"license": "MIT",
	"author": {
		"name": "roottool",
		"url": "https://github.com/roottool"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/roottool/portfolio.git"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "bun run scripts/generate-og.ts && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "run-s -c lint:*",
		"lint:oxfmt": "oxfmt --check",
		"lint:oxeslint": "astro check && oxlint && eslint --max-warnings=0 .",
		"lint:markuplint": "markuplint \"**/*.astro\"",
		"fix": "run-s -c fix:* format",
		"fix:oxeslint": "oxlint --fix && eslint --fix .",
		"format": "oxfmt"
	},
	"dependencies": {
		"@astrojs/check": "0.9.12",
		"@fontsource/cinzel-decorative": "5.3.0",
		"@fontsource/cormorant-garamond": "5.3.0",
		"@fontsource/cormorant-sc": "5.3.0",
		"@fontsource/noto-serif-jp": "5.3.1",
		"astro": "7.4.10"
	},
	"devDependencies": {
		"@astrojs/compiler-rs": "0.5.3",
		"@markuplint/astro-parser": "5.5.0",
		"@resvg/resvg-js": "2.6.2",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"@typescript-eslint/parser": "8.72.2",
		"eslint": "10.14.0",
		"eslint-config-flat-gitignore": "2.4.0",
		"eslint-plugin-astro": "3.2.1",
		"eslint-plugin-oxlint": "1.93.0",
		"globals": "17.14.0",
		"markuplint": "5.5.0",
		"npm-run-all2": "9.0.4",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2006",
		"satori": "0.63.2",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3"
	},
	"packageManager": "bun@1.4.4"
}
